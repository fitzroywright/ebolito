<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <CommonRoot Condition="'$(CommonRoot)' == ''">$(MSBuildProjectDirectory)/../../Common</CommonRoot>
    <UseCommonStorage Condition="'$(UseCommonStorage)' == '' and Exists('$(CommonRoot)/Common.Storage/Common.Storage.csproj')">true</UseCommonStorage>
    <DefineConstants Condition="'$(UseCommonStorage)' == 'true'">$(DefineConstants);COMMON_STORAGE</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Ebolito.Domain/Ebolito.Domain.csproj" />
    <ProjectReference Include="../Ebolito.Application/Ebolito.Application.csproj" />
    <ProjectReference Include="../Ebolito.Infrastructure/Ebolito.Infrastructure.csproj" />
    <ProjectReference Include="$(CommonRoot)/Common.Registration/Common.Registration.csproj" />
    <ProjectReference Include="$(CommonRoot)/Common.Secrets/Common.Secrets.csproj" />
    <ProjectReference Include="$(CommonRoot)/Common.Messaging/Common.Messaging.csproj" />
    <ProjectReference Include="$(CommonRoot)/Common.Messaging/Common.Messaging.Hosting/Common.Messaging.Hosting.csproj" />
    <ProjectReference Condition="'$(UseCommonStorage)' == 'true'" Include="$(CommonRoot)/Common.Storage/Common.Storage.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Update="Configuration/ebolito.configuration-contract.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
</Project>